# KIFARU environment template.
#
# Copy to `.env` and fill in values:  cp .env.example .env
# `.env` is gitignored. NEVER put a real credential in this file — it is tracked,
# and it must contain placeholders only.
#
# Every value below is a LOCAL DEVELOPMENT default. None of this is a
# production-hardening configuration, and none of it is a secret.

# --- PostgreSQL (consumed by docker-compose.yml) ---------------------------
POSTGRES_USER=kifaru
# PLACEHOLDER. Replace before running. Compose refuses to start while this is
# unset, deliberately: a default password would be a hardcoded credential.
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=kifaru
POSTGRES_PORT=5432

# --- Application -----------------------------------------------------------
# Connection string used by the `kifaru` binary and the integration tests.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://kifaru:change-me-local-dev-only@localhost:5432/kifaru

# The single configured currency. Money is stored as i64 MINOR UNITS; `KES`
# has a minor-unit scale of 2 (100 cents = 1 shilling). Changing this requires a
# migration and a matching `Currency` variant in `kifaru-domain`.
KIFARU_CURRENCY=KES

# Identifier for the Phase 1 development identity.
#
# THIS IS NOT AUTHENTICATION AND NOT A SECURITY CONTROL. It exists so that
# idempotency keys can be scoped while the real token-verification strategy is
# still undecided. Anyone can send this value. Do not deploy with it.
KIFARU_DEV_CLIENT_ID=dev-client

# Bind address for `kifaru serve`.
KIFARU_BIND=127.0.0.1:8080

# --- Observability ---------------------------------------------------------
# `json` for structured logs (default), `pretty` for human-readable local output.
KIFARU_LOG_FORMAT=pretty
KIFARU_LOG_LEVEL=kifaru=debug,tower_http=debug,info

# --- Worker ----------------------------------------------------------------
# Outbox worker tuning. Leases must exceed the longest expected publish.
KIFARU_WORKER_LEASE_SECONDS=30
KIFARU_WORKER_MAX_ATTEMPTS=8
KIFARU_WORKER_POLL_INTERVAL_MS=500
